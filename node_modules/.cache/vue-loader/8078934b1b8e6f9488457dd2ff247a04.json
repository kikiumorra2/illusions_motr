{"remainingRequest":"/home/lusha/Загрузки/2026_Summer/mousetracking/pilot2_4_paradigms/motr-eyetrack-pilot-1/node_modules/vue-loader/lib/index.js??vue-loader-options!/home/lusha/Загрузки/2026_Summer/mousetracking/pilot2_4_paradigms/motr-eyetrack-pilot-1/src/components/BrowserCheck.vue?vue&type=style&index=0&id=4cdfaa0c&prod&lang=css","dependencies":[{"path":"/home/lusha/Загрузки/2026_Summer/mousetracking/pilot2_4_paradigms/motr-eyetrack-pilot-1/src/components/BrowserCheck.vue","mtime":1794344098172},{"path":"/home/lusha/Загрузки/2026_Summer/mousetracking/pilot2_4_paradigms/motr-eyetrack-pilot-1/node_modules/css-loader/dist/cjs.js","mtime":1794344129425},{"path":"/home/lusha/Загрузки/2026_Summer/mousetracking/pilot2_4_paradigms/motr-eyetrack-pilot-1/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1794344130435},{"path":"/home/lusha/Загрузки/2026_Summer/mousetracking/pilot2_4_paradigms/motr-eyetrack-pilot-1/node_modules/postcss-loader/src/index.js","mtime":1794344129552},{"path":"/home/lusha/Загрузки/2026_Summer/mousetracking/pilot2_4_paradigms/motr-eyetrack-pilot-1/node_modules/cache-loader/dist/cjs.js","mtime":1794344129003},{"path":"/home/lusha/Загрузки/2026_Summer/mousetracking/pilot2_4_paradigms/motr-eyetrack-pilot-1/node_modules/vue-loader/lib/index.js","mtime":1794344129782}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["BrowserCheck.vue"],"names":[],"mappings":";AA2FA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;;AAEA;;AAEA;;AAEA;AACA;AACA;AACA","file":"BrowserCheck.vue","sourceRoot":"src/components","sourcesContent":["<!--\n  BrowserCheck — asks the participant to set the browser zoom to 100% before the study.\n  The MoTR window and the word boxes are defined in CSS pixels, so a zoomed page changes\n  their physical size on screen. The check re-runs whenever the window is resized (zoom\n  changes fire a resize event). Settings: config.browserCheck.\n-->\n<template>\n  <div class=\"browser-check\">\n\n    <!-- STEP 1 -->\n    <template v-if=\"!showPreview\">\n      <p>\n        <b>Please reset your browser zoom to 100% before continuing.</b>\n      </p>\n\n      <p>\n        Press <kbd>Ctrl</kbd> + <kbd>0</kbd> on Windows/Linux,\n        or <kbd>&#8984;</kbd> + <kbd>0</kbd> on Mac.\n      </p>\n\n      <p>\n        Please use a desktop or laptop computer with a mouse or trackpad,\n        <b>make this window full-screen</b> and not bigger than your screen. Keep it open and do not change the zoom until the study is complete.\n      </p>\n\n      <button @click=\"showPreview = true\">\n        I have reset the zoom to 100% and maximized my window\n      </button>\n    </template>\n\n    <!-- STEP 2 -->\n    <template v-else>\n      <p>\n        <b>Please check text box below.</b>\n      </p>\n\n      <p>\n        Being able to see the entire text is crucial for this study, so if you cannot fully see \"START\" and \"END\" in the box,\n        <b>we kindly ask you to quit this study.</b> Thank you.\n      </p>\n\n      <div class=\"sentence-preview-window\">\n        <div\n          class=\"sentence-preview\"\n          :style=\"{ fontSize: sentenceFontSize + 'px' }\"\n        >{{previewSentence}}</div>\n      </div>\n\n\n      <button @click=\"$emit('done')\">\n        The text fits on my screen\n      </button>\n    </template>\n\n  </div>\n</template>\n\n\n<script>\n\nexport default {\n  name: \"BrowserCheck\",\n\n  props: {\n    longestSentence: {\n      type: String,\n      required: true,\n    },\n\n    sentenceFontSize: {\n      type: Number,\n      required: true,\n    },\n  },\n\n  data() {\n    return {\n      showPreview: false,\n    };\n  },\n\n  computed: {\n    previewSentence() {\n      //return \"With schools still closed, cars still buried and streets still blocked by the widespread weekend snowstorm, officials are asking people to help out.\";\n        return \"START--------------------------------------------------------------------------------------------------------------------------------------------END\";\n    },\n  },\n};\n</script>\n\n<style>\n.browser-check kbd {\n  border: 1px solid #999;\n  border-radius: 3px;\n  padding: 0 4px;\n  font-family: inherit;\n}\n\n.sentence-preview-window {\n  width: calc(100vw - 2px);\n  max-width: calc(100vw - 2px);\n\n  margin-top: 30px;\n  margin-bottom: 30px;\n\n  margin-left: 50%;\n  transform: translateX(-50%);\n\n  overflow: hidden;\n  box-sizing: border-box;\n\n  border: 1px solid #999;\n  padding: 1px;\n}\n\n.sentence-preview {\n  font-family: Consolas, monospace;\n  font-weight: 450;\n\n  white-space: nowrap !important;\n  width: 100%;\n\n  text-align: center;\n\n  pointer-events: none;\n\n  user-select: none;\n  -webkit-user-select: none;\n  -moz-user-select: none;\n}\n</style>\n"]}]}